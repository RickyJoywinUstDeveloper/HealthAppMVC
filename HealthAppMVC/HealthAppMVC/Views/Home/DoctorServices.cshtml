@{
    ViewBag.Title = "Doctor Services";
}

<div class="container mt-5">

    <h2 class="text-center mb-5">
        Doctor Services
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["Success"]
        </div>
    }

    <div class="row g-4">

        <div class="col-md-4">
            <a href="@Url.Action("Create","Doctor")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">

                        <div style="font-size:50px;">➕👨‍⚕️</div>

                        <h5 class="mt-3">
                            Register Doctor
                        </h5>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a href="@Url.Action("SearchDoctor","Doctor")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">

                        <div style="font-size:50px;">✏️</div>

                        <h5 class="mt-3">
                            Edit Doctor Details
                        </h5>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a href="@Url.Action("DoctorSearch","Doctor")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">

                        <div style="font-size:50px;">🔍</div>

                        <h5 class="mt-3">
                            View Doctor Details
                        </h5>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a href="@Url.Action("SearchPatientHistory","HealthRecord")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">

                        <div style="font-size:50px;">📋</div>

                        <h5 class="mt-3">
                            Patient Health History
                        </h5>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">

            <a href="@Url.Action(
        "UpcomingAppointments",
        "Appointment")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">

                        <div style="font-size:50px;">
                            📅
                        </div>

                        <h5 class="mt-3">
                            Upcoming Appointments
                        </h5>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-4">
            <a href="@Url.Action("Index","Home")"
               class="text-decoration-none">

                <div class="card shadow text-center">

                    <div class="card-body">
                        <div style="font-size:50px;">🏠</div>

                        <h5 class="mt-3">
                            Home
                        </h5>

                    </div>

                </div>

            </a>
        </div>

    </div>

</div>