@model SharedDto.AppointmentDtos.AppointmentDto

@{
    ViewBag.Title = "Cancel Appointment";
}

<h2>Cancel Appointment</h2>

<div class="card">

    <div class="card-body">

        <p>
            <strong>Patient:</strong>
            @Model.PatientName
        </p>

        <p>
            <strong>Doctor:</strong>
            @Model.DoctorName
        </p>

        <p>
            <strong>Date:</strong>
            @Model.ScheduledDate
            .ToString("dd-MM-yyyy")
        </p>

        <p>
            <strong>Time Slot:</strong>
            @Model.TimeSlot
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">

                <label>
                    Cancellation Reason
                </label>

                <textarea name="cancellationReason"
                          class="form-control"
                          rows="4">
                </textarea>

            </div>

            <br />

            <button type="submit"
                    class="btn btn-warning">

                Cancel Appointment

            </button>

            @Html.ActionLink(
                "Back",
                "Index",
                null,
                new
                {
                    @class =
                    "btn btn-secondary"
                })
        }

    </div>

</div>