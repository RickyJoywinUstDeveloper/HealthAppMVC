@using HealthAppMVC.Models
@model IEnumerable<HealthAppMVC.Models.Appointment>


@{
    var appointmentsWithRecords =
        ViewBag.AppointmentsWithRecords
        as List<int>;
}


<h2 class="mb-4">📅 Upcoming Appointments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@using (Html.BeginForm("UpcomingAppointments", "Appointment", FormMethod.Get))
{
    <div class="row mb-4">

        <div class="col-md-4">

            <input type="text"
                   id="doctorName"
                   name="doctorName"
                   class="form-control"
                   placeholder="Search Doctor"
                   value="@ViewBag.DoctorName" />

        </div>

        <div class="col-md-2">

            <button class="btn btn-primary">
                Search
            </button>

        </div>

        <div class="col-md-2">
            <a href="@Url.Action("DoctorServices", "Home")"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>
}

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5>👨‍⚕️ @item.DoctorName</h5>
                    <p>👤 Patient: @item.PatientName</p>

                    <p>📅 @item.ScheduledDate.ToString("dd-MMM-yyyy")</p>
                    <p>⏰ @item.TimeSlot</p>

                    <p>
                        Status:
                        @if (item.Status == AppointmentStatus.Pending)
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                        else if (item.Status == AppointmentStatus.Confirmed)
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                    </p>

                    @if (item.Status == AppointmentStatus.Pending)
                    {
                        <a href="@Url.Action("Confirm", "Appointment", new { id = item.AppointmentId })"
                           class="btn btn-success btn-sm">
                            Confirm
                        </a>

                        <a href="@Url.Action("Cancel", "Appointment", new { id = item.AppointmentId })"
                           class="btn btn-danger btn-sm">
                            Cancel
                        </a>
                    }

                    @if (item.Status == AppointmentStatus.Confirmed
&& !appointmentsWithRecords.Contains(item.AppointmentId))
                    {
                        <a href="@Url.Action(
            "Create",
            "HealthRecord",
            new
            {
                appointmentId =
                    item.AppointmentId
            })"
                           class="btn btn-success">
                            Add Health Record
                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>

<script>
    $(document).ready(function () {

        $("#doctorName").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '/Doctor/SearchDoctorNames',
                    type: 'GET',
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            select: function (event, ui) {
                $("#doctorId").val(ui.item.value);
                $("#doctorName").val(ui.item.label);
                return false;
            }
        });

    });
</script>