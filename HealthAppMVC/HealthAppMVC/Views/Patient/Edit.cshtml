@model HealthAppMVC.Models.Patient

@{
    ViewBag.Title = "Edit Patient";
}

<h2>Edit Patient</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.PatientId)

    <div class="form-horizontal">

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" })

        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(
     m => m.FullName,
     new { @class = "form-control" })

            @Html.ValidationMessageFor(
                m => m.FullName,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>DOB</label>

            @Html.TextBoxFor(
                m => m.DateOfBirth,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date"
                })

            @Html.ValidationMessageFor(
    m => m.DateOfBirth,
    "",
    new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Gender</label>

            @Html.DropDownListFor(
                m => m.Gender,
                new SelectList(Enum.GetValues(
                    typeof(HealthAppMVC.Models.GenderType))),
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Phone</label>

            @Html.TextBoxFor(
                         m => m.PhoneNumber,
                         new { @class = "form-control" })

            @Html.ValidationMessageFor(
    m => m.PhoneNumber,
    "",
    new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Email</label>

            @Html.TextBoxFor(
                m => m.Email,
                new { @class = "form-control" })

            @Html.ValidationMessageFor(
    m => m.Email,
    "",
    new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Insurance ID</label>

            @Html.TextBoxFor(
                m => m.InsuranceId,
                new { @class = "form-control" })
        </div>

        <br />

        <input type="submit"
               value="Update"
               class="btn btn-warning" />

        @Html.ActionLink(
            "Back",
            "Index",
            null,
            new { @class = "btn btn-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}