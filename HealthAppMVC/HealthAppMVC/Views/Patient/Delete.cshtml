@model SharedDto.PatientDtos.PatientDto

@{
    ViewBag.Title = "Delete Patient";
}

<h2>Delete Patient</h2>

<div class="alert alert-danger">

    Are you sure you want to delete

    <strong>
        @Model.FullName
    </strong> ?

</div>

<div class="card mb-3">

    <div class="card-body">

        <p>
            <strong>Patient ID:</strong>
            @Model.PatientId
        </p>

        <p>
            <strong>Name:</strong>
            @Model.FullName
        </p>

        <p>
            <strong>Date of Birth:</strong>
            @Model.DateOfBirth
            .ToString("dd-MM-yyyy")
        </p>

        <p>
            <strong>Gender:</strong>
            @Model.Gender
        </p>

        <p>
            <strong>Phone:</strong>
            @Model.PhoneNumber
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Insurance ID:</strong>
            @Model.InsuranceId
        </p>

    </div>

</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    @Html.ActionLink(
        "Cancel",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
}