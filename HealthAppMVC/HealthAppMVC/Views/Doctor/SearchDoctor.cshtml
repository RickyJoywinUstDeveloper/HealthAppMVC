@model IEnumerable<SharedDto.DoctorDtos.DoctorDto>

@{
    ViewBag.Title = "Edit Doctor";
}

<style>

    .doctor-card {
        border: none;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        transition: transform 0.2s ease;
    }

        .doctor-card:hover {
            transform: translateY(-3px);
        }
</style>

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>
                ✏️ Edit Doctor Details
            </h3>

        </div>

        <div class="card-body">

            <div class="mb-4">

                <label class="form-label">
                    Search Doctor
                </label>

                <input type="text"
                       id="doctorSearch"
                       class="form-control"
                       placeholder="Type doctor name..." />

            </div>

            <div class="row"
                 id="doctorContainer">

                @foreach (var doctor in Model)
                {
                    <div class="col-md-6 mb-3 doctor-wrapper">

                        <div class="card doctor-card h-100">

                            <div class="card-body">

                                <h5 class="doctor-name">
                                    👨‍⚕️ @doctor.FullName
                                </h5>

                                <p>
                                    <strong>
                                        Specialisation:
                                    </strong>
                                    @doctor.Specialisation
                                </p>

                                <p>
                                    <strong>
                                        Phone:
                                    </strong>
                                    @doctor.DoctorPhoneNo
                                </p>

                                <p>
                                    <strong>
                                        Email:
                                    </strong>
                                    @doctor.DoctorEmail
                                </p>

                                <p>
                                    <strong>
                                        Experience:
                                    </strong>
                                    @doctor.YearsOfExperience Years
                                </p>

                                <p>
                                    <strong>
                                        Consultation Fee:
                                    </strong>
                                    ₹@doctor.ConsultationFee
                                </p>

                                <a href="@Url.Action(
                                            "Edit",
                                            "Doctor",
                                            new
                                            {
                                                id =
                                                doctor.DoctorId
                                            })"
                                   class="btn btn-primary">

                                    Edit Doctor

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <div id="noResults"
                 class="alert alert-info mt-3"
                 style="display:none;">

                No doctors found.

            </div>

            <a href="@Url.Action(
                        "DoctorServices",
                        "Home")"
               class="btn btn-secondary mt-3">

                Back

            </a>

        </div>

    </div>

</div>

@section Scripts{

    <script>

        $(function () {

            $("#doctorSearch")
                .on("keyup", function () {

                    var searchText =
                        $(this)
                            .val()
                            .toLowerCase();

                    var visibleCount = 0;

                    $(".doctor-wrapper")
                        .each(function () {

                            var doctorName =
                                $(this)
                                    .find(".doctor-name")
                                    .text()
                                    .toLowerCase();

                            if (doctorName
                                .indexOf(searchText) > -1) {
                                $(this).show();

                                visibleCount++;
                            }
                            else {
                                $(this).hide();
                            }

                        });

                    if (visibleCount === 0) {
                        $("#noResults").show();
                    }
                    else {
                        $("#noResults").hide();
                    }

                });

        });

    </script>

}