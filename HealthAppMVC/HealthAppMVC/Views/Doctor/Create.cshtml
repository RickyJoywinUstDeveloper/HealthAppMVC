@model HealthAppMVC.Models.Doctor

@{
    ViewBag.Title = "Add Doctor";
}

<h2>Add Doctor</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "text-danger" })

    <div class="form-group">
        <label>Name</label>

        @Html.TextBoxFor(
            m => m.FullName,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.FullName)
    </div>

    <div class="form-group">
        <label>Specialisation</label>

        @Html.DropDownListFor(
            m => m.Specialisation,
            new SelectList(
                Enum.GetValues(
                    typeof(
                        HealthAppMVC.Models.SpecialisationType))),
            "--Select--",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Phone Number</label>

        @Html.TextBoxFor(
            m => m.DoctorPhoneNo,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.DoctorPhoneNo)
    </div>

    <div class="form-group">
        <label>Email</label>

        @Html.TextBoxFor(
            m => m.DoctorEmail,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.DoctorEmail)
    </div>

    <div class="form-group">
        <label>Experience</label>

        @Html.TextBoxFor(
            m => m.YearsOfExperience,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.YearsOfExperience)
    </div>

    <div class="form-group">
        <label>Consultation Fee</label>

        @Html.TextBoxFor(
            m => m.ConsultationFee,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.ConsultationFee)
    </div>

    <br />

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

    @Html.ActionLink(
        "Back",
        "DoctorServices",
        "Home",
        null,
        new { @class = "btn btn-secondary" })
}