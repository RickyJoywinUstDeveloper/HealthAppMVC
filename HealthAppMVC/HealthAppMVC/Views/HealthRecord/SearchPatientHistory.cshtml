@{
    ViewBag.Title =
        "Patient Health History";
}

<h2 class="mb-4">
    Patient Health History
</h2>

<div class="form-group">

    <label>
        Patient Name
    </label>

    <input type="text"
           id="patientName"
           class="form-control" />

    <input type="hidden"
           id="patientId" />

</div>

<br />

<button id="btnHistory"
        class="btn btn-primary">

    View History

</button>

@section Scripts{

    <script>

$(function () {

    $("#patientName")
        .autocomplete({

        source:
        '@Url.Action(
        "SearchPatientNames",
        "HealthRecord")',

        minLength: 1,

        select: function (
            event,
            ui)
        {
            $("#patientId")
                .val(ui.item.value);
        }
    });

    $("#btnHistory").click(function () {

        var id = $("#patientId").val();

        if (!id || id === "0") {
            alert("Please select a patient from suggestions");
            return;
        }

        window.location =
            '/HealthRecord/History?patientId=' + id;
    });
});

    </script>

}