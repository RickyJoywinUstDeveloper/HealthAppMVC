@model IEnumerable<HealthAppMVC.Models.HealthRecord>

@{
    ViewBag.Title = "Patient Health History";
}

<h2 class="mb-3">🩺 Patient Health History</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- SEARCH BOX -->
@using (Html.BeginForm("History", "HealthRecord", FormMethod.Get))
{
    <div class="row mb-4">

        <div class="col-md-6">
            <input type="text"
                   name="patientName"
                   class="form-control"
                   placeholder="Search Patient Name" />

        </div>

        <div class="col-md-2">
            <button class="btn btn-primary">
                Search
            </button>
        </div>

    </div>
}

<!-- CARDS VIEW -->
<div class="row">

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">

                <div class="card shadow-sm h-100 border-0">

                    <div class="card-body">

                        <h5 class="card-title">
                            👨‍⚕️ @item.DoctorName
                        </h5>

                        <p>
                            <strong>Specialisation:</strong>
                            @item.Specialisation
                        </p>

                        <p>
                            <strong>Visit Date:</strong>
                            @item.VisitDate.ToString("dd-MMM-yyyy")
                        </p>

                        <p>
                            <strong>Diagnosis:</strong>
                            @item.Diagnosis
                        </p>

                        <p>
                            <strong>Prescription:</strong>
                            @item.Prescription
                        </p>

                        <a href="@Url.Action("Details", "HealthRecord", new { id = item.HealthRecordId })"
                           class="btn btn-sm btn-outline-primary">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                No health records found for this patient.
            </div>
        </div>
    }

</div>